---
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #ffffff;
        --bg-nav: #fbfbfa;
        --fg: #191919;
        --fg-muted: #787774;
        --fg-faint: #9b9a97;
        --border: #ebebea;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #191919;
          --bg-nav: #202020;
          --fg: #e9e9e7;
          --fg-muted: #9b9a97;
          --fg-faint: #6f6e69;
          --border: #2f2f2f;
        }
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial,
          sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--fg);
        outline-offset: 2px;
      }

      h1 {
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin: 0;
      }

      nav.topnav {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        padding: 0.95rem 1.5rem;
        background: color-mix(in srgb, var(--bg-nav) 92%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
      }

      nav.topnav .brand {
        font-weight: 600;
        text-decoration: none;
        font-size: 0.95rem;
        white-space: nowrap;
      }

      main {
        max-width: 680px;
        margin: 0 auto;
        padding: 3rem 1.5rem 6rem;
      }

      footer {
        text-align: center;
        color: var(--fg-faint);
        font-size: 0.8rem;
        padding: 2rem 1.5rem;
      }
    </style>
  </head>
  <body>
    <nav class="topnav">
      <a class="brand" href={`${base}/`}>Changelog</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer>Redmotos © {new Date().getFullYear()}</footer>
  </body>
</html>
