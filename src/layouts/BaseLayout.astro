---
import { apps } from "../data/apps";

interface Props {
  title: string;
  activeApp?: string;
}

const { title, activeApp } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #ffffff;
        --bg-subtle: #f8fafc;
        --fg: #0f172a;
        --fg-muted: #64748b;
        --border: #e2e8f0;
        --accent: #2563eb;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b1120;
          --bg-subtle: #111827;
          --fg: #e2e8f0;
          --fg-muted: #94a3b8;
          --border: #1f2937;
        }
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        line-height: 1.6;
      }

      a {
        color: inherit;
      }

      nav.topnav {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 0.9rem 1.5rem;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
      }

      nav.topnav .brand {
        font-weight: 700;
        text-decoration: none;
        font-size: 1rem;
      }

      nav.topnav .tabs {
        display: flex;
        gap: 0.25rem;
        overflow-x: auto;
      }

      nav.topnav .tabs a {
        text-decoration: none;
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        font-size: 0.875rem;
        color: var(--fg-muted);
        white-space: nowrap;
      }

      nav.topnav .tabs a.active,
      nav.topnav .tabs a:hover {
        background: var(--bg-subtle);
        color: var(--fg);
      }

      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1.5rem 5rem;
      }

      footer {
        text-align: center;
        color: var(--fg-muted);
        font-size: 0.8rem;
        padding: 2rem 1.5rem;
      }
    </style>
  </head>
  <body>
    <nav class="topnav">
      <a class="brand" href={`${base}/`}>Changelog</a>
      <div class="tabs">
        {
          apps.map((app) => (
            <a
              href={`${base}/${app.slug}/`}
              class={activeApp === app.slug ? "active" : ""}
            >
              {app.name}
            </a>
          ))
        }
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>Redmotos — novedades de nuestras apps</footer>
  </body>
</html>
