---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  alt: string;
}

const { images, alt } = Astro.props;

const PREVIEW_LIMIT = 2;
const preview = images.slice(0, PREVIEW_LIMIT);
const hiddenCount = images.length - preview.length;
---

{
  images.length > 0 && (
    <>
      <div class:list={["gallery", { collage: preview.length > 1 }]}>
        {preview.map((img, i) => (
          <button type="button" class="gallery-item" data-index={i}>
            <Image src={img} alt={alt} width={preview.length > 1 ? 480 : 960} />
            {i === preview.length - 1 && hiddenCount > 0 && (
              <span class="gallery-more">+{hiddenCount}</span>
            )}
          </button>
        ))}
      </div>

      <dialog class="lightbox">
        <button type="button" class="lightbox-close" data-close aria-label="Cerrar">
          ×
        </button>
        {images.length > 1 && (
          <button type="button" class="lightbox-nav prev" data-prev aria-label="Anterior">
            ‹
          </button>
        )}
        <div class="lightbox-stage">
          {images.map((img, i) => (
            <Image
              src={img}
              alt={alt}
              width={1600}
              class="lightbox-img"
              data-index={i}
              hidden={i !== 0}
            />
          ))}
        </div>
        {images.length > 1 && (
          <button type="button" class="lightbox-nav next" data-next aria-label="Siguiente">
            ›
          </button>
        )}
      </dialog>
    </>
  )
}

<style>
  .gallery {
    margin-bottom: 1.5rem;
  }

  .gallery.collage {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.5rem;
  }

  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    line-height: 0;
  }

  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .collage .gallery-item :global(img) {
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .gallery-more {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 1.25rem;
    font-weight: 600;
    border-radius: 8px;
  }

  .lightbox {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.88);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-stage {
    max-width: 92vw;
    max-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-stage :global(img) {
    max-width: 92vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
  }

  .lightbox-close,
  .lightbox-nav {
    position: fixed;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-close {
    top: 1.25rem;
    right: 1.25rem;
    width: 2.5rem;
    height: 2.5rem;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    font-size: 2rem;
  }

  .lightbox-nav.prev {
    left: 1.25rem;
  }

  .lightbox-nav.next {
    right: 1.25rem;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: rgba(0, 0, 0, 0.75);
  }
</style>

<script>
  function initGalleries() {
    document.querySelectorAll<HTMLDivElement>(".gallery").forEach((gallery) => {
      const dialog = gallery.nextElementSibling as HTMLDialogElement | null;
      if (!dialog || dialog.tagName !== "DIALOG") return;

      const slides = Array.from(
        dialog.querySelectorAll<HTMLElement>(".lightbox-img"),
      );
      let current = 0;

      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.hidden = i !== current;
        });
      };

      gallery.querySelectorAll<HTMLButtonElement>(".gallery-item").forEach((item) => {
        item.addEventListener("click", () => {
          show(Number(item.dataset.index));
          dialog.showModal();
        });
      });

      dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
      dialog.querySelector("[data-prev]")?.addEventListener("click", () => show(current - 1));
      dialog.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));

      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });

      dialog.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") show(current - 1);
        if (e.key === "ArrowRight") show(current + 1);
      });
    });
  }

  initGalleries();
  document.addEventListener("astro:after-swap", initGalleries);
</script>
